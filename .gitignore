# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
**/.DS_Store
*.pem
.idea
.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Heavy original assets kept locally only (compressed versions live alongside)
public/images/_originals/
public/videos/_originals/

# Large video files (use external hosting or CDN)
public/images/**/*.mp4
public/images/**/*.MP4
public/videos/*
*.mp4
*.MP4
*.mov
*.MOV

# Creator page videos are compressed and served from the repo.
# Includes the per-category subfolders: GEAR, EXPERIENCES, UNBOXING, TALK, CINEMATIC
!public/videos/creator
!public/videos/creator/**
# Plans drone des bandeaux Destinations et Journal (16/09), compressés en 1080p.
!public/videos/banners
!public/videos/banners/**

# Videos embedded in journal articles (20/09), compressed like the others.
!public/videos/journal
!public/videos/journal/**
public/videos/creator/**/.DS_Store

# typescript
*.tsbuildinfo
next-env.d.ts
tsconfig.check.json

# Sélections mises de côté (non servies, non versionnées) et corbeille manuelle
/_attente/
/_to_delete/

# Videos du portfolio : hebergees sur Cloudflare R2, pas dans le depot.
# Elles pesaient 333 Mo et repartaient en copie a chaque deploiement.
# Les posters, eux, restent ici. Voir scripts/sync-videos.mjs.
public/videos/creator/**/*.mp4
public/videos/creator/**/*.MP4
public/videos/creator/**/*.mov
public/videos/creator/**/*.MOV
public/videos/creator/**/*.webm
