# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
**/.DS_Store
*.pem
.idea
.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Heavy original assets kept locally only (compressed versions live alongside)
public/images/_originals/
public/videos/_originals/

# Large video files (use external hosting or CDN)
public/images/**/*.mp4
public/images/**/*.MP4
public/videos/*
*.mp4
*.MP4

# Creator page videos are compressed and served from the repo
!public/videos/creator
!public/videos/creator/*.mp4

# typescript
*.tsbuildinfo
next-env.d.ts
tsconfig.check.json
