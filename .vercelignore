# Large uncompressed film files (use public/videos/film/ for compressed versions)
public/images/film/

# Old series folders no longer used in main portfolio
public/images/series/

# Old galerie folder
public/images/galerie/

# Large video originals & unused video folders
public/videos/_originals/
public/videos/city-diary/

# Creator originals (compressed versions are in public/videos/creator/)
public/images/creator/

# Videos du portfolio : hebergees sur Cloudflare R2, pas dans le depot.
# Elles pesaient 333 Mo et repartaient en copie a chaque deploiement.
# Les posters, eux, restent ici. Voir scripts/sync-videos.mjs.
public/videos/creator/**/*.mp4
public/videos/creator/**/*.MP4
public/videos/creator/**/*.mov
public/videos/creator/**/*.MOV
public/videos/creator/**/*.webm

# Le Worker qui sert les videos n'a rien a faire dans le deploiement du site.
workers/
